---
import SectionKicker from "../presentation/SectionKicker.astro";
import Footer from "./Footer.astro";
import SocialButton from "./SocialButton.astro";
---

<section class="section wrap" id="contact">
  <SectionKicker index="03" label="Get in touch" align="center" />
  <h2>Contact</h2>
  <p>
    Feel free to reach out for new opportunities, collaborations or just to
    chat about frontend architecture and user experience.
  </p>
  <div class="socials">
    <SocialButton href="https://github.com/sergialcaraz" label="GitHub">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.1A10 10 0 0 0 8.2 21.6c.5.1.7-.2.7-.5v-1.8c-2.9.6-3.5-1.4-3.5-1.4-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.3-.3-4.8-1.2-4.8-5.2 0-1.1.4-2.1 1.1-2.8-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 2.9 1.1a10 10 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.6 1.5.2 2.6.1 2.9.7.7 1.1 1.7 1.1 2.8 0 4-2.5 4.9-4.8 5.2.4.3.7 1 .7 2v3c0 .3.2.6.7.5A10 10 0 0 0 12 2.1Z"></path>
      </svg>
    </SocialButton>
    <SocialButton href="https://www.linkedin.com/in/sergialcaraz" label="LinkedIn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5ZM3.5 9.2h3v11.3h-3V9.2Zm5.3 0h2.9v1.5h.1c.4-.8 1.5-1.7 3.1-1.7 3.3 0 3.9 2.1 3.9 4.9v6.6h-3v-5.8c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1v5.9h-3V9.2Z"></path>
      </svg>
    </SocialButton>
  </div>
</section>
<Footer />

<style>
  .section {
    padding-top: 2.5rem;
    padding-bottom: 0.5rem;
    text-align: center;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 2.7rem);
    letter-spacing: -0.04em;
    margin-bottom: 0.8rem;
  }

  p {
    max-width: 42rem;
    margin: 0 auto 1.6rem;
    color: var(--text-muted);
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 1.6rem;
  }
</style>
