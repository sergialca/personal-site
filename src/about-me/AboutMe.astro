---
import SectionKicker from "../presentation/SectionKicker.astro";
---

<section class="section wrap" id="about">
  <SectionKicker index="02" label="Editorial Profile" />
  <h2>About me</h2>
  <blockquote>
    “With nearly a decade of experience as a front-end developer, I specialize in collaborating with cross-functional teams to deliver high-quality digital products. Skilled in translating design systems into seamless user experiences, driving team collaboration, and adopting cutting-edge tools to maximize development efficiency.”
  </blockquote>
</section>

<style>
  .section {
    padding-bottom: 5.5rem;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 2.7rem);
    letter-spacing: -0.04em;
    margin-bottom: 1.4rem;
  }

  blockquote {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 1.6rem 1.8rem;
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.7;
    box-shadow: var(--shadow);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem 1.8rem;
    list-style: none;
    margin-top: 1.15rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  li::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--green);
  }
</style>
