---
interface Props {
  index: string;
  label: string;
  align?: "left" | "center";
}

const { index, label, align = "left" } = Astro.props;
---

<p class:list={["kicker", align]}>
  <span>{index}</span>
  <span class="slash">//</span>
  <span>{label}</span>
</p>

<style>
  .kicker {
    display: none;
  }

  .center {
    justify-content: center;
  }

  .slash {
    opacity: 0.7;
  }
</style>
