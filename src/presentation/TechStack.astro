---
const stack = [
  { name: "Astro", color: "#FF5D01" },
  { name: "Javascript", color: "#F7DF1E" },
  { name: "Node", color: "#5FA04E" },
  { name: "HTML5", color: "#E34F26" },
  { name: "CSS", color: "#1572B6" },
  { name: "GitHub", color: "#ffffff" },
  { name: "Supabase", color: "#3ECF8E" },
] as const;

function icon(name: string) {
  switch (name) {
    case "Astro":
      return `<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12.6 2.2 8.1 14.4c1.7-1.2 4-1.9 6.6-1.4-.9 1.6-1.4 3.4-1.4 5.2 2.8-2.1 4.8-5.3 5.7-9.1L12.6 2.2Zm-1.3 19.6c.5-2.3 1.8-4.3 3.7-5.6-.2 3.6.9 5.7 2.4 7.8-2.4.1-4.4-.7-6.1-2.2Z"/></svg>`;
    case "Javascript":
      return `<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M4 3h16v18H4V3Zm9.2 13.4c0 1.9-1.1 2.8-3 2.8-1.6 0-2.7-.8-3.3-1.8l1.6-1c.4.7.8 1.2 1.6 1.2.8 0 1.3-.3 1.3-1.5v-6h1.8v6.3Zm2.3 2.8c-1.9 0-3.1-1-3.7-2.2l1.6-1c.4.8 1 1.4 2 1.4.8 0 1.3-.4 1.3-1s-.5-.8-1.8-1.2c-1.9-.6-3.1-1.5-3.1-3.3 0-1.8 1.4-3.1 3.5-3.1 1.5 0 2.6.5 3.4 1.9l-1.5 1c-.4-.7-.8-1-1.8-1-.7 0-1.2.4-1.2.9 0 .6.4.8 1.8 1.3 2 .7 3.2 1.6 3.2 3.3 0 1.9-1.5 3.2-3.7 3.2Z"/></svg>`;
    case "Node":
      return `<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 2.2 3.8 7v10L12 21.8 20.2 17V7L12 2.2Zm0 2.2 6 3.4v6.8l-6 3.4-6-3.4V7.8l6-3.4Z"/></svg>`;
    case "HTML5":
      return `<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M4.2 3h15.6l-1.4 16.1L12 21.4 5.6 19.1 4.2 3Zm3.3 5.2h9.1l-.2 2.3H9.6l.2 1.8h6.4l-.7 7.3L12 18.4l-3.4-1-.2-2.5h2.1l.1 1.1 1.4.4 1.5-.4.2-2.1H8.4L7.5 8.2Z"/></svg>`;
    case "CSS":
      return `<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M4.2 3h15.6l-1.4 16.1L12 21.4 5.6 19.1 4.2 3Zm3.4 5.1h9l-.2 2.2H11l.2 1.7h5l-.6 6.4L12 19.3l-3.5-.9-.3-2.9h2.2l.1 1.2 1.5.4 1.5-.4.2-2.4H8.4L7.6 8.1Z"/></svg>`;
    case "GitHub":
      return `<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 2.1A10 10 0 0 0 8.2 21.6c.5.1.7-.2.7-.5v-1.8c-2.9.6-3.5-1.4-3.5-1.4-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.3-.3-4.8-1.2-4.8-5.2 0-1.1.4-2.1 1.1-2.8-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 2.9 1.1a10 10 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.6 1.5.2 2.6.1 2.9.7.7 1.1 1.7 1.1 2.8 0 4-2.5 4.9-4.8 5.2.4.3.7 1 .7 2v3c0 .3.2.6.7.5A10 10 0 0 0 12 2.1Z"/></svg>`;
    case "Supabase":
      return `<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M14.2 3.1c.4-.6 1.3-.3 1.3.5v7.6h5c.9 0 1.3 1.1.6 1.7l-8.3 8c-.4.5-1.3.2-1.3-.5v-7.6H6.6c-.9 0-1.3-1.1-.6-1.7l8.2-8Z"/></svg>`;
    default:
      return "";
  }
}
---

<div class="wrap stack">
  {stack.map((item) => (
    <span class="pill">
      <span class="icon" style={`color:${item.color}; background: color-mix(in srgb, ${item.color} 16%, #111218)`} set:html={icon(item.name)} />
      {item.name}
    </span>
  ))}
</div>

<style>
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding-bottom: 4.5rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.38rem 0.78rem 0.38rem 0.4rem;
    border-radius: 999px;
    background: #14151c;
    border: 1px solid var(--border-strong);
    color: #d7dce3;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .icon {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    display: grid;
    place-items: center;
  }
</style>
