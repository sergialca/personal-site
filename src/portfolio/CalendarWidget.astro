---
const days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

const weeks = [
  [
    { n: 22, muted: true },
    { n: 23, muted: true },
    { n: 24, muted: true },
    { n: 25, muted: true, dots: ["booked", "booked"] },
    { n: 26, muted: true },
    { n: 27, muted: true },
    { n: 28, muted: true },
  ],
  [
    { n: 29, muted: true },
    { n: 30, muted: true },
    { n: 1 },
    { n: 2, dots: ["booked"] },
    { n: 3, badge: "10", tone: "open" },
    { n: 4 },
    { n: 5 },
  ],
  [
    { n: 6 },
    { n: 7 },
    { n: 8 },
    { n: 9 },
    { n: 10, badge: "10", tone: "open" },
    { n: 11 },
    { n: 12 },
  ],
  [
    { n: 13 },
    { n: 14 },
    { n: 15 },
    { n: 16 },
    { n: 17, badge: "Reserved", tone: "reserved" },
    { n: 18, badge: "10", tone: "open" },
    { n: 19 },
  ],
];
---

<div class="calendar">
  <div class="top">
    <p>MONTH / YEAR</p>
    <strong>May 2025</strong>
    <button type="button">Today</button>
  </div>
  <div class="grid">
    {days.map((day) => <span class="dow">{day}</span>)}
    {weeks.flat().map((cell) => (
      <div class:list={["cell", { muted: cell.muted }]}>
        <span class="n">{cell.n}</span>
        {"dots" in cell && cell.dots ? (
          <span class="dots">
            {cell.dots.map(() => <i></i>)}
          </span>
        ) : null}
        {"badge" in cell && cell.badge ? (
          <span class:list={["badge", cell.tone]}>{cell.badge}</span>
        ) : null}
      </div>
    ))}
  </div>
  <div class="legend">
    <span><i class="booked"></i> Confirmed Slots</span>
    <span><i class="open"></i> Open Availability</span>
  </div>
</div>

<style>
  .calendar {
    background: #11131a;
    border: 1px solid var(--border-strong);
    border-radius: 22px;
    padding: 1.15rem 1.2rem 1rem;
    min-height: 320px;
  }

  .top {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .top p {
    grid-column: 1;
    color: var(--text-dim);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  .top strong {
    grid-column: 1;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }

  .top button {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    border: 0;
    background: #1c1f2a;
    color: var(--text-muted);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.78rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
  }

  .dow {
    text-align: center;
    color: var(--text-dim);
    font-size: 0.7rem;
    font-weight: 600;
    padding-bottom: 4px;
  }

  .cell {
    min-height: 58px;
    border-radius: 10px;
    background: #171922;
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .n {
    font-size: 0.78rem;
    font-weight: 600;
  }

  .muted {
    opacity: 0.45;
  }

  .dots {
    display: flex;
    gap: 3px;
    margin-top: auto;
  }

  .dots i,
  .legend i {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #7c5cff;
    display: inline-block;
  }

  .badge {
    margin-top: auto;
    font-size: 0.58rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 2px 5px;
    width: fit-content;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .open {
    background: rgba(62, 207, 142, 0.16);
    color: var(--green);
  }

  .reserved {
    background: rgba(124, 92, 255, 0.18);
    color: #b9a6ff;
  }

  .legend {
    display: flex;
    gap: 1.1rem;
    margin-top: 0.85rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend .open {
    background: var(--green);
    width: 7px;
    height: 7px;
    padding: 0;
    border-radius: 999px;
  }

  .legend .booked {
    background: #7c5cff;
  }
</style>
